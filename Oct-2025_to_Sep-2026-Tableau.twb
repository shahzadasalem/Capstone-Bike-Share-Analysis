          <datasource-dependencies datasource='federated.0d4vth81i5lu8h19r1lxv000zzk9'>
            <column caption='Ride Start Hour' datatype='integer' name='[Calculation_0262026686697475]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEPART(&apos;hour&apos;, [started_at])' />
            </column>
            <column caption='Number of Rides' datatype='integer' name='[Calculation_0262026726391818]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([ride_id])' />
            </column>
            <column caption='Average Duration (Min)' datatype='real' name='[Calculation_0262026726604811]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([ride_length_minutes])' />
            </column>
            <column caption='Std Dev Duration (Min)' datatype='real' name='[Calculation_0262026726764556]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='STDEV([ride_length_minutes])' />
            </column>
            <column caption='Lower Quartile Duration (Min)' datatype='real' name='[Calculation_0262026726895629]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='PERCENTILE([ride_length_minutes], 0.25)' />
            </column>
            <column caption='Median Duration (Min)' datatype='real' name='[Calculation_0262026726973454]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MEDIAN([ride_length_minutes])' />
            </column>
            <column caption='Upper Quartile Duration (Min)' datatype='real' name='[Calculation_0262026727505935]' role='measure' type='quantitative'>
